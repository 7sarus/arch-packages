# Maintainer: Alex Potapenko <opotapenko@gmail.com>
# Vendored from AUR calibre-bin. Man-page generation removed, so the build
# needs no sphinx and no calibre source tarball.

pkgname=calibre-bin
pkgver=9.19.0
pkgrel=1
pkgdesc="Official binary version Calibre"
arch=(x86_64)
url="https://download.calibre-ebook.com"
license=(GPL-3.0-only)
depends=(libglvnd fontconfig libxkbcommon nss alsa-lib)
conflicts=(calibre calibre-git)
provides=(calibre)
options=('!strip')

# share.tar.xz carries the desktop, icon, mime and completion files that the
# upstream tarball does not ship.
source=(
	share.tar.xz
	$url/${pkgver}/calibre-${pkgver}-x86_64.txz
)
sha256sums=(
	'c7aae61afba19c9cceed8bbafd2b39b5c4d6d683de0ccfc9c1fe2651857f757a'
	'35c1cbda1a2548aceeb89cb0a4be47a36025b5dc102ac046f7eaf98ba46a452d'
)

check() {
	QT_QPA_PLATFORM=offscreen "$srcdir/calibre-debug" --version
}

# The bundle's libpython3.14 exports _Py_InitializeMain, which Arch's libpython
# does not, so system python3 cannot drive this binary. Keep the bundled one.

package() {
	install -dm755 "$pkgdir/opt/calibre" "$pkgdir/usr"
	cp -a "$srcdir"/bin "$srcdir"/lib "$srcdir"/libexec "$srcdir"/resources \
		"$srcdir"/plugins "$srcdir"/translations "$pkgdir/opt/calibre/"
	cp -a "$srcdir"/share "$pkgdir/usr/"
	# calibre looks up its espeak data relative to its own prefix
	install -dm755 "$pkgdir/opt/calibre/share"
	mv "$pkgdir"/usr/share/espeak-ng-data "$pkgdir"/opt/calibre/share/

	for f in "$srcdir"/*; do
		[[ -f $f && -x $f ]] && cp -a "$f" "$pkgdir/opt/calibre/"
	done

	install -dm755 "$pkgdir/usr/bin"
	for f in "$pkgdir"/opt/calibre/*; do
		[[ -f $f ]] && ln -s "/opt/calibre/${f##*/}" "$pkgdir/usr/bin/${f##*/}"
	done
}
